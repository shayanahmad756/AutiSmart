{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "app": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:socket_app",
      "bindings": [
        {
          "type": "service",
          "service": "ml",
          "format": "url",
          "env": "ML_URL"
        }
      ]
    },
    "ml": {
      "root": "ML",
      "framework": "fastapi",
      "entrypoint": "api:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}